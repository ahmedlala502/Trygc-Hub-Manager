# AI Discovery provider keys. Settings can also store keys locally for desktop/demo use.
# Prefer server-side/proxy storage for production deployments.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_OPENAI_API_KEY="MY_OPENAI_API_KEY"
VITE_ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
VITE_OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
VITE_GROQ_API_KEY="MY_GROQ_API_KEY"
VITE_MISTRAL_API_KEY="MY_MISTRAL_API_KEY"
VITE_PERPLEXITY_API_KEY="MY_PERPLEXITY_API_KEY"
VITE_COHERE_API_KEY="MY_COHERE_API_KEY"
VITE_CUSTOM_AI_API_KEY="MY_CUSTOM_AI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
